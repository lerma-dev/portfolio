---
import Logo from "@icons/Logo.astro";
import Error from "@layouts/Error.astro";
---

<Error title="Oops 404 - lerma.dev">
  <main>
    <div class="error-code">404</div>
    <h1>Página perdida en el espacio</h1>
    <p>
      El proyecto o sección que buscas no existe o ha sido movido a otra ruta
      de despliegue.
    </p>
    <a href="/" class="btn-home">Regresar al Inicio</a>
  </main>
</Error>

<style>
  body {
    margin: 0;
    background: var(--lt-bg);
    color: var(--lt-text-color);
    font-family: sans-serif;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    overflow: hidden;
  }
  main {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    background: var(--lt-gradient);
  }
  .error-code {
    font-size: clamp(8rem, 20vw, 12rem);
    font-weight: 800;
    margin: 0;
    line-height: 0.8;
    opacity: 0.8;
    letter-spacing: -5px;
  }
  h1 {
    font-size: 2rem;
    margin: 20px 0 10px;
  }
  p {
    color: var(--lt-muted-color);
    max-width: 450px;
    margin-bottom: 30px;
    line-height: 1.6;
  }
  .btn-home {
    background: var(--lt-primary-color);
    color: white;
    padding: 14px 35px;
    border-radius: 30px;
    text-decoration: none;
    font-weight: 700;
    transition: 0.3s;
    text-transform: uppercase;
    font-size: 0.9rem;
  }
  .btn-home:hover {
    opacity: 0.9;
    transform: scale(1.05);
  }
</style>
