---
import Logo from "@icons/Logo.astro";
import Error from "@layouts/Error.astro";
---

<Error title="Oops 404 - lerma.dev">
  <nav>
    <Logo class="icon-xl" />
    <div class="logo">
      lerma<span>.dev</span>
    </div>
  </nav>
  <main>
    <div class="error-code">404</div>
    <h1>Página perdida en el espacio</h1>
    <p>Esta Aplicacion que buscabas no existe, Regresar al inicio para el</p>
    <a href="/" class="btn-home">Regresar al Inicio</a>
  </main>
</Error>

<style>
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    overflow: hidden;
  }
  nav {
    display: flex;
    align-items: center;
    padding: 20px 5%;
  }
  .logo {
    font-weight: 800;
    font-size: 1.5rem;
  }
  .logo span {
    color: var(--lt-primary-color);
  }
  main {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    background: radial-gradient(circle at center, #151b2d 0%, #0b0b0b 75%);
  }
  .error-code {
    font-size: clamp(8rem, 20vw, 12rem);
    font-weight: 800;
    margin: 0;
    line-height: 0.8;
    opacity: 0.8;
    letter-spacing: -5px;
  }
  h1 {
    font-size: 2rem;
    margin: 20px 0 10px;
  }
  p {
    color: var(--lt-muted-color);
    max-width: 450px;
    margin-bottom: 30px;
    line-height: 1.6;
  }
  .btn-home {
    background-color: var(--lt-primary-color);
    color: white;
    padding: 14px 35px;
    border-radius: 30px;
    text-decoration: none;
    font-weight: 700;
    transition: 0.3s;
    text-transform: uppercase;
    font-size: 0.9rem;
  }
  .btn-home:hover {
    opacity: 0.9;
    transform: scale(1.05);
  }
</style>
