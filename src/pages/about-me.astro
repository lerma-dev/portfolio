---
import Layout from "@layouts/Layout.astro";
import { AboutMe } from "@lib/SEO";
import { Image } from "astro:assets";
import IconGithub from "@icons/IconGithub.astro";
import IconVscode from "@icons/IconVscode.astro";
import IconReact from "@icons/IconReact.astro";
import IconGit from "@icons/IconGit.astro";
import IconWindows from "@icons/IconWindows.astro";
import IconTux from "@icons/IconTux.astro";
import IconHtml from "@icons/IconHtml.astro";
import IconCSS from "@icons/IconCSS.astro";
import IconJS from "@icons/IconJS.astro";
import IconIonic from "@icons/IconIonic.astro";
import IconPhp from "@icons/IconPhp.astro";
import IconNode from "@icons/IconNode.astro";
import IconDelfin from "@icons/IconDelfin.astro";
import IconExpress from "@icons/IconExpress.astro";
---

<Layout {...AboutMe}>
  <div class="about-page">
    <section class="hero">
      <div class="hero-glow"></div>
      <div class="profile-wrapper">
        <div class="profile-ring">
          <Image
            src="/lerma-dev.webp"
            alt="Foto de perfil de Héctor Lerma"
            class="profile-image"
            loading="eager"
            decoding="async"
            width={140}
            height={140}
          />
        </div>
      </div>
      <div class="hero-content">
        <span class="greeting"> ¡Hola! 👋 </span>
        <h1>Soy <span>Héctor Lerma</span></h1>
        <p class="hero-role">
          Desarrollador de software · Creador · Entusiasta de la tecnología
        </p>
        <p class="hero-description">
          Me gusta convertir ideas en software, experimentar con nuevas
          tecnologías y construir proyectos que puedan ser útiles para otras
          personas.
        </p>
      </div>

      <div class="hero-status">
        <span class="status-dot"></span>
        Actualmente creando y aprendiendo
      </div>
    </section>

    <!-- SOBRE MÍ-->
    <section class="section about-section">
      <div class="section-heading">
        <span>01</span>
        <h2>¿Quién soy?</h2>
      </div>

      <div class="about-grid">
        <div class="about-text">
          <p class="lead">
            Soy estudiante de ingeniería en desarrollo de software
            multiplataforma y un apasionado por la tecnología.
          </p>

          <p>
            Me encanta aprender cosas nuevas, experimentar con diferentes
            tecnologías y, sobre todo, llevar las ideas desde un concepto hasta
            un proyecto funcional.
          </p>

          <p>
            En este sitio comparto algunos de los proyectos y herramientas que
            voy desarrollando. Mi objetivo no es solamente crear software, sino
            también aprender durante el proceso y compartir lo que voy
            descubriendo.
          </p>

          <p>
            Creo que cualquier persona puede aprender a programar si tiene
            curiosidad, constancia y ganas de seguir intentando.
          </p>
        </div>

        <div class="about-highlights">
          <div class="highlight">
            <span class="highlight-number">01</span>
            <div>
              <h3>Crear</h3>
              <p>Convertir ideas en aplicaciones y proyectos reales.</p>
            </div>
          </div>

          <div class="highlight">
            <span class="highlight-number">02</span>
            <div>
              <h3>Aprender</h3>
              <p>
                Explorar tecnologías y mejorar constantemente mis habilidades.
              </p>
            </div>
          </div>

          <div class="highlight">
            <span class="highlight-number">03</span>
            <div>
              <h3>Compartir</h3>
              <p>
                Publicar proyectos y conocimientos para que otras personas
                también puedan aprender.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- LO QUE HAGO -->
    <section class="section services-section">
      <div class="section-heading center">
        <span>02</span>
        <h2>Lo que hago</h2>
        <p>Algunas de las áreas en las que me gusta desarrollar proyectos.</p>
      </div>

      <div class="services-grid">
        <article class="service-card">
          <div class="service-number">01</div>
          <div class="service-icon" aria-hidden="true">&lt;/&gt;</div>
          <h3>Desarrollo Web</h3>
          <p>
            Interfaces web, aplicaciones, sitios dinámicos y experiencias
            enfocadas en rendimiento y simplicidad.
          </p>
          <div class="service-tags">
            <span>HTML</span>
            <span>CSS</span>
            <span>JavaScript</span>
          </div>
        </article>

        <article class="service-card">
          <div class="service-number">02</div>
          <div class="service-icon" aria-hidden="true">{"📱"}</div>
          <h3>Desarrollo Multiplataforma</h3>
          <p>
            Aplicaciones que buscan aprovechar las ventajas de diferentes
            plataformas y tecnologías.
          </p>
          <div class="service-tags">
            <span>Ionic</span>
            <span>Capacitor</span>
            <span>React</span>
          </div>
        </article>

        <article class="service-card">
          <div class="service-number">03</div>

          <div class="service-icon" aria-hidden="true">{"🧪"}</div>

          <h3>Proyectos personales</h3>

          <p>
            Experimentos, herramientas y aplicaciones creadas para aprender,
            probar ideas y resolver problemas reales.
          </p>

          <div class="service-tags">
            <span>Ideas</span>
            <span>Experimentos</span>
            <span>Software</span>
          </div>
        </article>
      </div>
    </section>

    <!-- SKILLS -->
    <section class="section skills-section">
      <div class="section-heading center">
        <span>03</span>
        <h2>Mis tecnologías</h2>
        <p>Herramientas y tecnologías con las que trabajo o experimento.</p>
      </div>

      <div class="skills-grid">
        <!-- Frontend -->
        <article class="skill-category">
          <div class="category-header">
            <div class="category-icon">&lt;/&gt;</div>

            <div>
              <h3>Frontend</h3>
              <p>Interfaces y experiencias web</p>
            </div>
          </div>

          <div class="skill-list">
            <span class="skill">
              <IconHtml class="icon-sm" style="color: #f88417" aria-hidden="true"/>
              HTML
            </span>

            <span class="skill">
              <IconCSS class="icon-sm" style="color: #006dfc" aria-hidden="true"/>
              CSS
            </span>

            <span class="skill">
              <IconJS class="icon-sm" style="color: #fffb00" aria-hidden="true"/>
              JavaScript
            </span>

            <span class="skill">
              <IconReact class="icon-sm" style="color: #17a6f8" aria-hidden="true"/>
              React
            </span>

            <span class="skill">
              <IconIonic class="icon-sm" style="color: #1a65eb" aria-hidden="true"/>
              Ionic + Capacitor
            </span>
          </div>
        </article>

        <!-- Backend -->
        <article class="skill-category">
          <div class="category-header">
            <div class="category-icon">{"{}"}</div>

            <div>
              <h3>Backend & BD</h3>
              <p>Lógica y almacenamiento</p>
            </div>
          </div>

          <div class="skill-list">
            <span class="skill">
              <IconPhp class="icon-sm" style="color: #b74ee0" aria-hidden="true"/>
              PHP
            </span>

            <span class="skill">
              <IconNode class="icon-sm" style="color: #81CD38" aria-hidden="true"/>
              Node.js
            </span>

            <span class="skill">
              <IconExpress class="icon-sm" style="color: #ffffff" aria-hidden="true"/>
              Express
            </span>

            <span class="skill">
              <IconDelfin class="icon-sm" style="color: #17a6f8" aria-hidden="true"/>
              MySQL
            </span>
          </div>
        </article>

        <!-- Herramientas -->
        <article class="skill-category">
          <div class="category-header">
            <div class="category-icon">⚙</div>

            <div>
              <h3>Herramientas</h3>
              <p>Mi entorno de desarrollo</p>
            </div>
          </div>

          <div class="skill-list">
            <span class="skill">
              <IconGit class="icon-sm" style="color: #f36a0f" aria-hidden="true"/>
              Git
            </span>

            <span class="skill">
              <IconGithub class="icon-sm" aria-hidden="true"/>
              GitHub
            </span>

            <span class="skill">
              <IconWindows class="icon-sm" style="color: #17a6f8" aria-hidden="true"/>
              Windows
            </span>

            <span class="skill">
              <IconTux class="icon-sm" style="color: #ffffff" aria-hidden="true"/>
              Linux
            </span>

            <span class="skill">
              <IconVscode class="icon-sm" style="color: #0065a9" aria-hidden="true"/>
              VS Code
            </span>
          </div>
        </article>
      </div>
    </section>

    <!-- ESTADO ACTUAL -->
    <section class="current-section">
      <div class="current-content">
        <div class="current-label">
          <span class="status-dot"></span>
          ACTUALMENTE
        </div>

        <h2>
          Siempre estoy
          <span>construyendo algo.</span>
        </h2>

        <p>
          Actualmente continúo aprendiendo, desarrollando proyectos personales y
          experimentando con nuevas ideas para seguir mejorando como
          desarrollador.
        </p>

        <div class="current-items">
          <div>
            <span>🚀</span>
            <strong>Construyendo</strong>
            <small>Nuevos proyectos</small>
          </div>

          <div>
            <span>📚</span>
            <strong>Aprendiendo</strong>
            <small>Nuevas tecnologías</small>
          </div>

          <div>
            <span>🧪</span>
            <strong>Experimentando</strong>
            <small>Nuevas ideas</small>
          </div>
        </div>
      </div>
    </section>

    <!-- FILOSOFÍA -->
    <section class="section philosophy-section">
      <div class="section-heading center">
        <span>04</span>
        <h2>Mi filosofía de desarrollo</h2>
        <p>Algunas ideas que intento mantener presentes al crear software.</p>
      </div>

      <div class="philosophy-grid">
        <article class="philosophy-card">
          <div class="philosophy-icon">🔐</div>

          <span class="philosophy-number">01</span>

          <h3>Privacidad</h3>

          <p>
            Me interesa crear software que respete al usuario y reduzca la
            dependencia de telemetría invasiva y publicidad innecesaria.
          </p>
        </article>

        <article class="philosophy-card">
          <div class="philosophy-icon">⚡</div>

          <span class="philosophy-number">02</span>

          <h3>Rendimiento</h3>

          <p>
            Prefiero soluciones eficientes y ligeras, intentando que cada
            funcionalidad tenga un propósito y que el software se sienta rápido.
          </p>
        </article>

        <article class="philosophy-card">
          <div class="philosophy-icon">🌐</div>

          <span class="philosophy-number">03</span>

          <h3>Comunidad</h3>

          <p>
            Compartir conocimientos y proyectos permite que otras personas
            aprendan, colaboren y puedan construir cosas todavía mejores.
          </p>
        </article>
      </div>
    </section>
  </div>
</Layout>

<style>
  .about-page {
    width: 100%;
    overflow: hidden;
    background: var(--lt-gradient);
    color: var(--lt-text-color);
  }
  .section {
    width: min(1100px, calc(100% - 40px));
    margin: 0 auto;
    padding: 100px 0;
  }
  /*=== HERO ===*/
  .hero {
    position: relative;
    min-height: 650px;
    padding: 100px 20px 80px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    overflow: hidden;
  }
  .hero-glow {
    position: absolute;
    top: 0;
    left: 50%;
    width: 600px;
    height: 600px;
    transform: translateX(-50%);
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(0, 102, 255, 0.13),
      transparent 68%
    );
    pointer-events: none;
  }
  .profile-wrapper {
    position: relative;
    z-index: 1;
    margin-bottom: 25px;
  }
  .profile-ring {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 5px;
    border: 3px solid var(--lt-primary-color);
    border-radius: 50%;
    box-shadow:
      0 0 25px rgba(23, 166, 248, 0.35),
      0 0 70px rgba(23, 166, 248, 0.08);
    animation: profileFloat 5s ease-in-out infinite;
  }
  .profile-image {
    width: 135px;
    height: 135px;
    border-radius: 50%;
    object-fit: cover;
  }
  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 800px;
  }
  .greeting {
    display: inline-block;
    padding: 7px 15px;
    margin-bottom: 15px;
    border: 1px solid rgba(23, 166, 248, 0.3);
    border-radius: 100px;
    background: rgba(23, 166, 248, 0.08);
    color: var(--lt-primary-color);
    font-size: 0.85rem;
    font-weight: 700;
  }
  .hero h1 {
    margin: 0;
    font-size: clamp(2.8rem, 7vw, 5rem);
    line-height: 1;
    letter-spacing: -0.06em;
    font-weight: 850;
  }
  .hero h1 span {
    color: var(--lt-primary-color);
  }
  .hero-role {
    margin: 22px 0 0;
    font-size: clamp(1rem, 2vw, 1.25rem);
    font-weight: 600;
    opacity: 0.85;
  }
  .hero-description {
    max-width: 650px;
    margin: 20px auto 0;
    font-size: 1rem;
    line-height: 1.8;
    opacity: 0.6;
  }
  .hero-status {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 28px;
    padding: 8px 15px;
    border: 1px solid var(--lt-border);
    border-radius: 100px;
    background: var(--lt-surface);
    font-size: 0.78rem;
    opacity: 0.8;
  }
  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #2ecc71;
    box-shadow: 0 0 10px rgba(46, 204, 113, 0.8);
  }
  /*=== SECTION HEADINGS ===*/
  .section-heading {
    margin-bottom: 55px;
  }
  .section-heading > span {
    display: block;
    margin-bottom: 10px;
    color: var(--lt-primary-color);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.15em;
  }
  .section-heading h2 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 2.8rem);
    letter-spacing: -0.04em;
  }
  .section-heading p {
    max-width: 600px;
    margin: 15px auto 0;
    opacity: 0.55;
    line-height: 1.7;
  }
  .section-heading.center {
    text-align: center;
  }
  /*=== SOBRE MÍ ===*/
  .about-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 80px;
    align-items: center;
  }
  .about-text {
    font-size: 1rem;
    line-height: 1.85;
  }
  .about-text p {
    margin: 0 0 20px;
    opacity: 0.7;
  }
  .about-text .lead {
    font-size: 1.35rem;
    line-height: 1.6;
    font-weight: 600;
    color: var(--lt-text-color);
    opacity: 1;
  }
  .about-highlights {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }
  .highlight {
    display: flex;
    gap: 18px;
    padding: 22px;
    border: 1px solid var(--lt-border);
    border-radius: 14px;
    background: var(--lt-surface);
    transition: 0.25s ease;
  }
  .highlight:hover {
    transform: translateX(5px);
    border-color: var(--lt-primary-color);
  }
  .highlight-number {
    color: var(--lt-primary-color);
    font-weight: 800;
    font-size: 0.75rem;
  }
  .highlight h3 {
    margin: 0 0 5px;
    font-size: 1rem;
  }
  .highlight p {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.5;
    opacity: 0.55;
  }
  /*=== SERVICIOS ===*/
  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }
  .service-card {
    position: relative;
    padding: 30px;
    border: 1px solid var(--lt-border);
    border-radius: 16px;
    background: var(--lt-surface);
    overflow: hidden;
    transition: 0.3s ease;
  }
  .service-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--lt-primary-color);
    transform: scaleX(0);
    transform-origin: left;
    transition: 0.3s ease;
  }
  .service-card:hover {
    transform: translateY(-6px);
    border-color: rgba(23, 166, 248, 0.4);
  }
  .service-card:hover::before {
    transform: scaleX(1);
  }
  .service-number {
    position: absolute;
    top: 22px;
    right: 25px;
    font-size: 0.7rem;
    opacity: 0.25;
    font-weight: 800;
  }
  .service-icon {
    margin-bottom: 22px;
    color: var(--lt-primary-color);
    font-size: 2rem;
    font-weight: 800;
  }
  .service-card h3 {
    margin: 0 0 12px;
    font-size: 1.15rem;
  }
  .service-card p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.7;
    opacity: 0.55;
  }
  .service-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 22px;
  }
  .service-tags span {
    padding: 5px 9px;
    border: 1px solid var(--lt-border);
    border-radius: 6px;
    font-size: 0.7rem;
    opacity: 0.65;
  }
  /*=== SKILLS ===*/
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }
  .skill-category {
    padding: 28px;
    border: 1px solid var(--lt-border);
    border-radius: 16px;
    background: var(--lt-surface);
  }
  .category-header {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-bottom: 25px;
  }
  .category-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 45px;
    height: 45px;
    border-radius: 10px;
    background: rgba(23, 166, 248, 0.1);
    color: var(--lt-primary-color);
    font-weight: 800;
  }
  .category-header h3 {
    margin: 0;
    font-size: 1rem;
  }
  .category-header p {
    margin: 3px 0 0;
    font-size: 0.75rem;
    opacity: 0.45;
  }
  .skill-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .skill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 11px;
    border: 1px solid var(--lt-border);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.025);
    font-size: 0.78rem;
    transition: 0.2s ease;
  }
  .skill:hover {
    border-color: var(--lt-primary-color);
    transform: translateY(-2px);
  }
  /*=== ACTUALMENTE ===*/
  .current-section {
    position: relative;
    width: min(1100px, calc(100% - 40px));
    margin: 40px auto;
    padding: 80px 50px;
    border: 1px solid rgba(23, 166, 248, 0.25);
    border-radius: 24px;
    background:
      radial-gradient(
        circle at 50% 0%,
        rgba(23, 166, 248, 0.12),
        transparent 60%
      ),
      var(--lt-surface);
    overflow: hidden;
  }
  .current-content {
    position: relative;
    z-index: 1;
    max-width: 800px;
    margin: auto;
    text-align: center;
  }
  .current-label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 20px;
    color: var(--lt-primary-color);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.15em;
  }
  .current-content h2 {
    margin: 0;
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.1;
    letter-spacing: -0.05em;
  }
  .current-content h2 span {
    display: block;
    color: var(--lt-primary-color);
  }
  .current-content > p {
    max-width: 650px;
    margin: 22px auto 0;
    line-height: 1.8;
    opacity: 0.6;
  }
  .current-items {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 35px;
  }
  .current-items > div {
    min-width: 150px;
    padding: 15px;
    border: 1px solid var(--lt-border);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.025);
  }
  .current-items span {
    display: block;
    margin-bottom: 8px;
  }
  .current-items strong,
  .current-items small {
    display: block;
  }
  .current-items strong {
    font-size: 0.85rem;
  }
  .current-items small {
    margin-top: 3px;
    font-size: 0.7rem;
    opacity: 0.45;
  }
  /*=== FILOSOFÍA ===*/
  .philosophy-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }
  .philosophy-card {
    position: relative;
    padding: 30px;
    border: 1px solid var(--lt-border);
    border-radius: 16px;
    background: var(--lt-surface);
    overflow: hidden;
    transition: 0.3s ease;
  }
  .philosophy-card:hover {
    transform: translateY(-5px);
    border-color: var(--lt-primary-color);
  }
  .philosophy-icon {
    margin-bottom: 25px;
    font-size: 1.7rem;
  }
  .philosophy-number {
    position: absolute;
    top: 30px;
    right: 30px;
    color: var(--lt-primary-color);
    font-size: 0.7rem;
    font-weight: 800;
  }
  .philosophy-card h3 {
    margin: 0 0 12px;
    font-size: 1.15rem;
  }
  .philosophy-card p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.75;
    opacity: 0.55;
  }

  /*ANIMACIÓN */
  @keyframes profileFloat {
    0%,
    100% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(-7px);
    }
  }
  /*TABLET*/
  @media (max-width: 899px) {
    .section {
      padding: 75px 0;
    }

    .about-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .services-grid,
    .skills-grid,
    .philosophy-grid {
      grid-template-columns: 1fr;
    }

    .current-section {
