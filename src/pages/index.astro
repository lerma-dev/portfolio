---
import { Main } from "@lib/Metadata.ts";
import Layout from "@layouts/Layout.astro";
import IconVerified from "@icons/IconVerified.astro";
import IconNoads from "@icons/IconNoads.astro";
import IconCode from "@icons/IconCode.astro";
import ProjectCard from "@components/ProjectCard.astro";
import { Projects } from "@lib/AppMetadata.ts";
---

<Layout {...Main}>
  <section class="hero">
    <div class="hero-content">
      <h1>Mis Aplicaciones</h1>
      <p>
        Explora todas mis aplicaciones web, móviles o de escritorio publicadas
        aquí. Todas están libres de anuncios, así que no tendrás nada intrusivo
        molestándote al explorarlas. Siente la libertad de usarlas y
        compartirlas para que más gente conozca estas increíbles aplicaciones
        hechas por <strong>@lerma.dev</strong>.
      </p>
      <div class="hero-features">
        <span>
          <IconVerified style="color: #3eee87" class="icon-sm" aria-hidden="true" />
          Verificado
        </span>
        <span>
          <IconNoads style="color: #ce4242" class="icon-sm" aria-hidden="true" />
          No anuncios
        </span>
        <span>
          <IconCode style="color: #0866FF" class="icon-sm" aria-hidden="true" />
          Codigo Abierto
        </span>
      </div>
      <a href="#aplicaciones" class="cta-button">VER APLICACIONES</a>
    </div>
  </section>

  <section id="aplicaciones" class="section-projects">
    <h2 class="section-title">Aplicaciones</h2>
    <div class="project-grid">
      {Projects.map((app) => <ProjectCard {...app} />)}
    </div>
  </section>
</Layout>

<style>
  .hero {
    width: 100%;
    padding: 100px 0 100px;
    background: var(--lt-gradient);
    position: relative;
  }
  .hero-content {
    max-width: 800px;
    margin: 0 auto; 
    padding: 0 20px;
    text-align: center;
  }
  .hero-content h1 {
    font-size: clamp(2.5rem, 7vw, 4.2rem);
    margin-bottom: 20px;
    font-weight: 800;
    letter-spacing: -1px;
  }
  .hero-content p {
    font-size: clamp(1rem, 2.5vw, 1.2rem);
    max-width: 700px;
    margin: 0 auto 50px;
    color: var(--lt-muted-color);
  }
  .hero-features {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 30px 0;
    justify-content: center;
  }
  .hero-features span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 8px 16px;
    border-radius: 50px;
    font-size: 0.9rem;
    font-weight: 500;
    color: #e2e8f0;
    backdrop-filter: blur(8px);
    transition: all 0.3s ease;
  }
  .cta-button {
    display: inline-block;
    text-decoration: none;
    padding: 15px 35px;
    border-radius: 50px;
    margin-top: 25px;
    font-size: 1rem;
    font-weight: 600;
    background: var(--lt-primary-color);
    transition: var(--lt-transition);
    box-shadow: 0 10px 25px rgba(79, 110, 189, 0.3);
    color: #fff;
  }
  .cta-button:hover {
    transform: translateY(-3px);
    background: var(--lt-hover-color);
    box-shadow: 0 15px 30px rgba(79, 110, 189, 0.4);
  }
  /* PROJECT GRID */
  .section-projects {
    width: 90%;
    max-width: 1200px;
    margin: 0 auto;
  }
  .section-title {
    text-align: center;
    margin: 80px 0 40px;
    font-size: 2.2rem;
    color: var(--lt-text-color);
    font-weight: 700;
  }
  .project-grid {
    display: grid;
    justify-content: center;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    margin-bottom: 80px;
    gap: 30px;
  }
</style>
