---
import IconFacebook from '@icons/IconFacebook.astro';
import IconInstagram from '@icons/IconInstagram.astro';
---
<footer>
  <p>&copy; 2026 lerma.dev Todos los derechos reservados.</p>
  <div class="footer-links">
    <div class="footer-item facebook">
      <IconFacebook arial-label="logo facebook" width="20" height="20" />
      <a href="https://www.facebook.com/profile.php?id=61582995253561" 
        target="_blank" rel="noopener noreferrer">
        Facebook
      </a>
    </div>
    <div class="footer-item instagram">
      <IconInstagram arial-label="logo instagram" width="20" height="20" />
      <a 
        href="https://www.instagram.com/lerma.dev?igsh=MTdlaGdmdnUwMXVyYQ==" 
        target="_blank" rel="noopener noreferrer">
        Instagram
      </a>   
    </div>
  </div>
</footer>

<style>
  /* FOOTER */
  footer {
    padding: 40px 20px;
    text-align: center;
    border-top: 1px solid rgba(255, 255, 255, 0.04);
    font-size: 0.85rem;
    color: var(--lt-muted-color);
  }
  .footer-links {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px 24px; /* Espacio adaptable entre elementos y filas */
    margin-top: 16px;
  }
  .footer-item {
    display: inline-flex;
    align-items: center;
    gap: 6px; /* Separa de forma limpia el icono del texto */
  }
  .footer-links a {
    color: var(--lt-text-color);
    text-decoration: none;
    opacity: 0.7;
    transition: var(--lt-transition);
  }
  .footer-links a:hover {
    opacity: 1;
    color: var(--lt-text-color);
  }
</style>