---
import { Image } from 'astro:assets';
interface Props {
  screenshots: string[];
  title: string;
}

const { screenshots, title } = Astro.props;
---

<div class="carousel-container">
  <div class="carousel-track">
    {
      screenshots.map((src, index) => (
        <Image
          src={src}
          alt={`Vista previa ${index + 1} de ${title}`}
          class="imgs-carousel"
          width={100}
          height={100}
        />
      ))
    }
  </div>
  <!-- Botones de navegación del carrusel -->
  {
    screenshots.length > 1 && (
      <>
        <button class="carousel-btn prev" aria-label="Anterior">
          &#10094;
        </button>
        <button class="carousel-btn next" aria-label="Siguiente">
          &#10095;
        </button>
      </>
    )
  }
</div>

<style>
  .carousel-container {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    display: flex;
  }
  .carousel-track {
    display: flex;
    width: 100%;
    height: 100%;
    transition: transform 0.4s ease-in-out;
  }
  .carousel-track .imgs-carousel {
    width: 100% !important;
    max-width: 100% !important;
    min-width: 100% !important;
    height: 100% !important;
    object-fit: contain;
    background-color: #050508;
    flex-shrink: 0;
  }
  .carousel-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(0, 0, 0, 0.6);
    color: var(--lt-text-color);
    border: none;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.9rem;
    opacity: 0;
    transition:
      opacity 0.3s ease,
      background 0.3s ease;
    z-index: 10;
  }
  .carousel-container:hover .carousel-btn {
    opacity: 1;
  }
  .carousel-btn:hover {
    background: var(--lt-opacity);
  }
  .carousel-btn.prev {
    left: 8px;
  }
  .carousel-btn.next {
    right: 8px;
  }
</style>

<script>
  function initCarousels() {
    document.querySelectorAll(".carousel-container").forEach((carousel) => {
      const track = carousel.querySelector(".carousel-track") as HTMLElement;
      const prevBtn = carousel.querySelector(".carousel-btn.prev");
      const nextBtn = carousel.querySelector(".carousel-btn.next");

      let currentIndex = 0;
      const totalImages = track?.children.length || 0;

      if (totalImages <= 1) return;

      const updateCarousel = () => {
        if (track) {
          track.style.transform = `translateX(-${currentIndex * 100}%)`;
        }
      };

      nextBtn?.addEventListener("click", (e) => {
        e.stopPropagation();
        currentIndex = (currentIndex + 1) % totalImages;
        updateCarousel();
      });

      prevBtn?.addEventListener("click", (e) => {
        e.stopPropagation();
        currentIndex = (currentIndex - 1 + totalImages) % totalImages;
        updateCarousel();
      });
    });
  }
  document.addEventListener("DOMContentLoaded", initCarousels);
  document.addEventListener("astro:page-load", initCarousels);
</script>
